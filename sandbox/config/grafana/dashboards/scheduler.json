{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": "-- Grafana --",
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "In-process Scheduler metrics: throughput, per-show farm share, tick health, group outcomes and fragmentation. Mirrors the Rust scheduler's metrics module.",
  "editable": true,
  "gnetId": null,
  "graphTooltip": 1,
  "links": [],
  "refresh": "30s",
  "schemaVersion": 30,
  "style": "dark",
  "tags": [
    "opencue",
    "scheduler"
  ],
  "templating": {
    "list": [
      {
        "current": {},
        "hide": 0,
        "includeAll": true,
        "label": "Show",
        "multi": true,
        "name": "show",
        "query": "label_values(cue_scheduler_show_cores, show)",
        "refresh": 2,
        "sort": 1,
        "type": "query",
        "datasource": "prometheus"
      }
    ]
  },
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timezone": "",
  "title": "OpenCue Scheduler",
  "uid": "opencue-scheduler",
  "panels": [
    {
      "type": "timeseries",
      "title": "Throughput",
      "description": "Frames booked per second, per show (rate of cue_scheduler_frames_dispatched_total).",
      "datasource": "prometheus",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "lineWidth": 0,
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "showPoints": "never",
            "axisLabel": "frames / sec"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "sum by (show) (rate(cue_scheduler_frames_dispatched_total{show=~\"$show\"}[5m]))",
          "legendFormat": "{{show}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Farm share by show",
      "description": "Cores in use per show right now, summed live from the procs each tick (accurate: sums to the farm, never over). Each band is a show's slice of the farm.",
      "datasource": "prometheus",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "lineWidth": 0,
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "showPoints": "never",
            "axisLabel": "cores"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "sum by (show) (cue_scheduler_show_cores{show=~\"$show\"})",
          "legendFormat": "{{show}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Tick duration",
      "description": "Scheduler tick wall-clock latency (p50/p95/p99). The core health signal.",
      "datasource": "prometheus",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 10,
            "showPoints": "never",
            "axisLabel": "seconds"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(cue_scheduler_tick_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(cue_scheduler_tick_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p95",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(cue_scheduler_tick_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p99",
          "refId": "C"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Farm booking performance",
      "description": "Every scheduler tick, each host-spec group lands in an outcome; this shows their mix as a share of all checks. booked (placed work) vs why it didn't \u2014 no fit (farm saturated), no work (nothing eligible), query error (bad tag). Each bar sums to 100%: mostly booked = healthy, mostly no fit = saturated, mostly no work = starved, any query error = misconfigured.",
      "datasource": "prometheus",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 70,
            "lineWidth": 0,
            "stacking": {
              "mode": "percent",
              "group": "A"
            },
            "showPoints": "never",
            "axisLabel": "share of checks"
          }
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "booked" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } } ] },
          { "matcher": { "id": "byName", "options": "no fit" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "yellow" } } ] },
          { "matcher": { "id": "byName", "options": "no work" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "blue" } } ] },
          { "matcher": { "id": "byName", "options": "query error" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } } ] }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "sum by (reason) (rate(cue_scheduler_group_pass_total[5m]))",
          "legendFormat": "{{reason}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Host-spec groups",
      "description": "Host-spec groups each tick, split by demand (has-work cut). active = the group had eligible work (booked, or no fit when the farm slice is full); inactive = no matching work at all. The stack height is the total group count — a spike toward the host count still signals tag fragmentation (a hostname leaking into tags). When tags/specs fragment demand, inactive rising is the tell: pools sitting idle with no work while others are slammed.",
      "datasource": "prometheus",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 70,
            "lineWidth": 0,
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "showPoints": "never",
            "axisLabel": "groups"
          }
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "active" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } } ] },
          { "matcher": { "id": "byName", "options": "inactive" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "blue" } } ] }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [ "mean", "max" ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "max(cue_scheduler_groups_by_state{state=\"active\"})",
          "legendFormat": "active",
          "refId": "A"
        },
        {
          "expr": "max(cue_scheduler_groups_by_state{state=\"inactive\"})",
          "legendFormat": "inactive",
          "refId": "B"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Fragmentation",
      "description": "Idle cores stranded on WORKING hosts (at least one core in use) that no ready frame could take this tick, as a share of the whole farm, by cause: (stranded idle on working hosts) / (total farm cores). cores = the leftover idle was too few on any one host for a waiting frame (wide layers); memory = idle cores whose host lacked the RAM; gpu = idle cores whose host lacked the GPU; held = idle cores on a host reserved for a wide job; license = idle cores a license shortage blocks; quota = idle cores a job/show/limit/folder cap holds back. Empty hosts aren't fragmented (one free block) so they don't count; normalizing over the whole farm keeps a lone busy host's leftover a tiny share -- it only climbs when the waste is farm-wide. A packed farm strands nothing; waiting work then shows under 'Why the farm isn't booking' as no fit.",
      "datasource": "prometheus",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 75,
            "lineWidth": 0,
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "showPoints": "never",
            "axisLabel": "% of farm"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "cores"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "memory"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "gpu"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "purple"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "held"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "yellow"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "license"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "blue"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "quota"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "sum by (reason) (cue_scheduler_fragmented_cores) / scalar(max(cue_scheduler_farm_cores_total)) * 100",
          "legendFormat": "{{reason}}",
          "refId": "A"
        }
      ]
    }
  ]
}