{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": "-- Grafana --",
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "OpenCue Maestro (in-process scheduler) metrics: throughput, per-show farm share, tick health, group outcomes and fragmentation. Mirrors the Rust scheduler's metrics module.",
  "editable": true,
  "gnetId": null,
  "graphTooltip": 1,
  "links": [],
  "refresh": "30s",
  "schemaVersion": 30,
  "style": "dark",
  "tags": [
    "opencue",
    "scheduler"
  ],
  "templating": {
    "list": [
      {
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "hide": 0,
        "includeAll": true,
        "label": "Show",
        "multi": true,
        "name": "show",
        "query": "label_values(cue_maestro_show_cores, show)",
        "refresh": 2,
        "sort": 1,
        "type": "query",
        "datasource": "prometheus"
      }
    ]
  },
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timezone": "",
  "title": "OpenCue Maestro",
  "uid": "opencue-maestro",
  "panels": [
    {
      "type": "text",
      "title": "",
      "transparent": true,
      "gridPos": {
        "h": 2,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "options": {
        "mode": "html",
        "content": "<div style=\"background:#1f2733;border-left:4px solid #5794F2;padding:10px 16px;border-radius:3px;font-family:system-ui;font-size:20px;font-weight:700;letter-spacing:2px;color:#d8d9da\">THROUGHPUT</div>"
      }
    },
    {
      "type": "timeseries",
      "title": "Throughput",
      "description": "Frames booked per second, per show (rate of cue_maestro_frames_dispatched_total).",
      "datasource": "prometheus",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 2
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "lineWidth": 0,
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "showPoints": "never",
            "axisLabel": "frames / sec"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "sum by (show) (rate(cue_maestro_frames_dispatched_total{show=~\"$show\"}[5m]))",
          "legendFormat": "{{show}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Farm share by show",
      "description": "Cores in use per show right now, summed live from the procs each tick (accurate: sums to the farm, never over). Each band is a show's slice of the farm.",
      "datasource": "prometheus",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 2
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "lineWidth": 0,
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "showPoints": "never",
            "axisLabel": "cores"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "sum by (show) (cue_maestro_show_cores{show=~\"$show\"})",
          "legendFormat": "{{show}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "text",
      "title": "",
      "transparent": true,
      "gridPos": {
        "h": 2,
        "w": 24,
        "x": 0,
        "y": 10
      },
      "options": {
        "mode": "html",
        "content": "<div style=\"background:#1f2733;border-left:4px solid #5794F2;padding:10px 16px;border-radius:3px;font-family:system-ui;font-size:20px;font-weight:700;letter-spacing:2px;color:#d8d9da\">UTILISATION</div>"
      }
    },
    {
      "type": "timeseries",
      "title": "Utilisation",
      "description": "Cores running as a share of the whole farm, from the live show_cores ledger (no SQL: plus on the batch commit, minus on the drain). High and steady = healthy. Low with a big waitlist = read 'What's holding frames' for the cause; low with an empty waitlist = no demand.",
      "datasource": "prometheus",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 12
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "min": 0,
          "max": 100,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 12,
            "showPoints": "never",
            "axisLabel": "% of farm running"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "utilisation"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "showLegend": false
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "sum(cue_maestro_show_cores) / scalar(max(cue_maestro_farm_cores_total)) * 100",
          "legendFormat": "utilisation",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "What's holding frames",
      "description": "Of ALL the frames the farm handles right now (running plus waiting), the share blocked by each cause, on a fixed 0-100 axis. A healthy farm shows small bars: most frames run or flow, so a 2% blocked slice reads as 2%. capacity = the farm is simply full. no fit = idle cores exist but none fits (slivers, memory or gpu). limit = a job, show, limit or folder cap. no license = a pool is out of seats or stale. held = every fitting host is reserved for a wide job. A limit share while cores sit idle = check the caps (a drifted job core counter shows up here).",
      "datasource": "prometheus",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 12
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "min": 0,
          "max": 100,
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 70,
            "lineWidth": 0,
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "showPoints": "never",
            "axisLabel": "% of all frames (running + waiting)"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "capacity"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "blue"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "held"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "yellow"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "limit"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "no fit"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "purple"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "no license"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "last",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "sum by (reason) (cue_maestro_waiting_frames{reason!=\"flowing\"}) / scalar(sum(cue_maestro_waiting_frames) + sum(cue_maestro_running_frames)) * 100",
          "legendFormat": "{{reason}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "text",
      "title": "",
      "transparent": true,
      "gridPos": {
        "h": 2,
        "w": 24,
        "x": 0,
        "y": 20
      },
      "options": {
        "mode": "html",
        "content": "<div style=\"background:#1f2733;border-left:4px solid #5794F2;padding:10px 16px;border-radius:3px;font-family:system-ui;font-size:20px;font-weight:700;letter-spacing:2px;color:#d8d9da\">MAESTRO PERFORMANCE</div>"
      }
    },
    {
      "type": "timeseries",
      "title": "Host-spec groups",
      "description": "Host-spec groups each tick, split by demand (has-work cut). active = the group had eligible work (booked, or no fit when the farm slice is full); inactive = no matching work at all. The stack height is the total group count \u2014 a spike toward the host count still signals tag fragmentation (a hostname leaking into tags). When tags/specs fragment demand, inactive rising is the tell: pools sitting idle with no work while others are slammed.",
      "datasource": "prometheus",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 22
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 70,
            "lineWidth": 0,
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "showPoints": "never",
            "axisLabel": "groups"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "active"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "inactive"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "blue"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "max(cue_maestro_groups_by_state{state=\"active\"})",
          "legendFormat": "active",
          "refId": "A"
        },
        {
          "expr": "max(cue_maestro_groups_by_state{state=\"inactive\"})",
          "legendFormat": "inactive",
          "refId": "B"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Tick duration",
      "description": "Maestro tick wall-clock latency (p50/p95/p99). The core health signal.",
      "datasource": "prometheus",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 22
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 10,
            "showPoints": "never",
            "axisLabel": "seconds"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(cue_maestro_tick_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(cue_maestro_tick_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p95",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(cue_maestro_tick_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p99",
          "refId": "C"
        }
      ]
    },
    {
      "type": "text",
      "title": "",
      "transparent": true,
      "gridPos": {
        "h": 2,
        "w": 24,
        "x": 0,
        "y": 30
      },
      "options": {
        "mode": "html",
        "content": "<div style=\"background:#1f2733;border-left:4px solid #5794F2;padding:10px 16px;border-radius:3px;font-family:system-ui;font-size:20px;font-weight:700;letter-spacing:2px;color:#d8d9da\">FARM HEALTH</div>"
      }
    },
    {
      "type": "timeseries",
      "title": "Booking locality",
      "description": "Frames booked per second by cache locality of the chosen host, classified at the decision from the same signals the locality bonus scored. Stacked: the full height is total booking throughput. One dial, both localities: live_warm = space (the chosen host runs the layer right now), cache_warm = time (the layer came back inside the warmth window), cold = the asset fetch is paid again.",
      "datasource": "prometheus",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 32
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 1,
            "fillOpacity": 45,
            "showPoints": "never",
            "axisLabel": "frames/s booked",
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "live_warm"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "cache_warm"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "yellow"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "cold"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "sum by (kind) (rate(cue_maestro_booked_frames_locality_total[1m]))",
          "legendFormat": "{{kind}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Warm share",
      "description": "Share of booked frames landing warm (live_warm + cache_warm). The cache-hit rate of placement; the sim measured ~90% live-warm with the bonus on vs ~60% off.",
      "datasource": "prometheus",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 32
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "min": 0,
          "max": 100,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 12,
            "showPoints": "never",
            "axisLabel": "% booked warm"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "warm share"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "showLegend": false
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "100 * sum(rate(cue_maestro_booked_frames_locality_total{kind!=\"cold\"}[1m])) / sum(rate(cue_maestro_booked_frames_locality_total[1m]))",
          "legendFormat": "warm share",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Stranded cores",
      "description": "Whole cores idle after planning that no waiting frame can buy: on each such host every candidate is stopped by cores, memory or gpu (usually memory, eaten by co-resident frames). The physical counterpart of the waitlist's 'no fit' bucket; sustained growth means the farm's idle is the wrong shape for the waiting work.",
      "datasource": "prometheus",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 32
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 20,
            "showPoints": "never",
            "axisLabel": "cores idle but unsellable"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "stranded"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "showLegend": false
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "max(cue_farm_health_stranded_cores)",
          "legendFormat": "stranded",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Swap in use, by hardware shape",
      "description": "Of each hardware shape's swap space, the share in use, straight from the host reports (no database read). Healthy hosts sit near 0%. A shape above the red 20% line is out of memory: its frames slow down and die. The same family also has cue_farm_health_hosts_swapping (a machine count) for alerts.",
      "datasource": "prometheus",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 40
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "min": 0,
          "max": 100,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 12,
            "showPoints": "never",
            "axisLabel": "% of swap spent",
            "thresholdsStyle": {
              "mode": "line"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 20
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "last",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "max by (name) (cue_farm_health_swap_used_frac{by=\"hwtype\"}) * 100",
          "legendFormat": "{{name}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Kernel time, by hardware shape",
      "description": "How much CPU time each hardware shape spends inside the Linux kernel (system time). 'mean' is the shape's average; 'worst host' is its sickest machine. Under 10% is normal. Above the red 30% line a host mostly serves page faults, interrupts or I/O instead of rendering. Needs the RQD sysTime report attribute; without it the line reads 0.",
      "datasource": "prometheus",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 40
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "min": 0,
          "max": 100,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 12,
            "showPoints": "never",
            "axisLabel": "% of CPU time in the kernel",
            "thresholdsStyle": {
              "mode": "line"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 30
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "last",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "max by (name) (cue_farm_health_system_time_pct{by=\"hwtype\"})",
          "legendFormat": "{{name}} mean"
        },
        {
          "expr": "max by (name) (cue_farm_health_system_time_pct_max{by=\"hwtype\"})",
          "legendFormat": "{{name}} worst host"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Swap in use, by spec group",
      "description": "The same swap story, cut by host-spec group (Maestro's booking pools: tags plus OS, gpu marked). Tells you which pool of the farm is memory starved, so you know which kind of work is at risk.",
      "datasource": "prometheus",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 48
      },
      "fieldConfig": {
        "defaults": {
