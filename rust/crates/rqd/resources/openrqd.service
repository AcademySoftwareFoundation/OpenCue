[Unit]
Description=OpenCue RQD Service
Wants=network.target graphical.target
After=network.target

[Service]
Environment=OPENCUE_RQD_CONFIG=/etc/openrqd/rqd.yaml
ExecStart=/usr/local/bin/openrqd
LimitNOFILE=500000
LimitNPROC=500000
StandardOutput=journal+console
StandardError=journal+console
SyslogIdentifier=openrqd
TimeoutSec=5
# Restart=on-failure also serves the RestartRqdNow/RestartRqdIdle RPCs: rqd
# exits with a non-zero code (42) to request a service restart, while a clean
# shutdown exits 0 and stays down.
Restart=on-failure
RestartSec=30
# Only signal the main rqd process on stop/restart. With the default
# KillMode=control-group, systemd would SIGTERM (and after TimeoutSec, SIGKILL)
# every process in the unit's cgroup - including running frames - which defeats
# rqd's live-restart frame recovery. Frames run in their own session (and, with
# runner.frame_cgroups, in their own cgroup) and are reattached by the new rqd
# instance through their on-disk snapshots.
KillMode=process
# Hand the unit's cgroup subtree over to rqd. With runner.frame_cgroups enabled,
# rqd contains every frame in <unit cgroup>/frames/<launch_id>, so all the
# processes a frame starts are tracked and killed with it. rqd enables no
# controllers below the unit cgroup, so systemd can always start a restarted
# rqd in it. Harmless while runner.frame_cgroups is off.
Delegate=yes

[Install]
WantedBy=multi-user.target
