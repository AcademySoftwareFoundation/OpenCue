# Multi-stage Dockerfile for OpenCue Rust RQD

# Build stage, with cargo-chef to build the dependencies in their own layer
FROM rust:1.88-bookworm AS chef

RUN cargo install cargo-chef --locked --version 0.1.72

# Install build dependencies
RUN apt-get update && apt-get install -y \
    protobuf-compiler \
    libprotobuf-dev \
    pkg-config \
    && rm -rf /var/lib/apt/lists/*

# Create app directory
WORKDIR /build

# Reduce the workspace to its manifests
FROM chef AS planner
COPY rust/Cargo.toml rust/Cargo.lock ./
COPY rust/crates ./crates
RUN cargo chef prepare --recipe-path recipe.json

FROM chef AS builder

# Build the dependencies, which change only with the manifests
COPY --from=planner /build/recipe.json ./
RUN cargo chef cook --release -p rqd --recipe-path recipe.json

# Copy the workspace manifests and only the crates RQD is built from
COPY rust/Cargo.toml rust/Cargo.lock ./
COPY rust/crates/rqd ./crates/rqd
COPY rust/crates/opencue-proto ./crates/opencue-proto

# Remove symlink and copy proto files from repo root
RUN rm ./crates/opencue-proto/src/protos
COPY proto/src ./crates/opencue-proto/src/protos

# Build RQD in release mode
RUN cargo build --release -p rqd

# Runtime stage
FROM debian:bookworm-slim

# Install runtime dependencies
RUN apt-get update && apt-get install -y \
    ca-certificates \
    libx11-6 \
    && rm -rf /var/lib/apt/lists/*

# Create app user
RUN useradd -m -u 1000 -s /bin/bash rqd

# Create necessary directories
RUN mkdir -p /app/resources && chown -R rqd:rqd /app

WORKDIR /app

# Copy the built binary from builder stage
COPY --from=builder /build/target/release/openrqd /app/openrqd

# Copy resources
COPY --from=builder /build/crates/rqd/resources /app/resources

# RQD gRPC server
EXPOSE 8444

# Run RQD
ENTRYPOINT ["/app/openrqd"]
CMD []
